// prisma/schema.prisma
// Hamplard — Database schema
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum CourseStatus {
  DRAFT         // instructor editing, not yet submitted
  PENDING       // submitted for admin review
  ACTIVE        // approved and enrollable
  PAUSED        // temporarily unavailable
  ARCHIVED      // permanently removed
}

enum EnrollmentStatus {
  ACTIVE        // enrolled and learning
  COMPLETED     // finished all lessons
  REFUNDED      // refunded (edge case)
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  ASSIGNMENT
}

enum QuestionType {
  MULTIPLE_CHOICE
  SINGLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum AssignmentStatus {
  PENDING       // student not submitted yet
  SUBMITTED     // student submitted, awaiting review
  APPROVED      // instructor approved
  REJECTED      // instructor rejected, student must resubmit
}

enum NotificationType {
  COURSE_APPROVED
  COURSE_REJECTED
  ENROLLMENT_CONFIRMED
  LESSON_UNLOCKED
  ASSIGNMENT_SUBMITTED
  ASSIGNMENT_APPROVED
  ASSIGNMENT_REJECTED
  COURSE_COMPLETED
  CERTIFICATE_ISSUED
  NEW_ENROLLMENT        // for instructors
  PAYMENT_RECEIVED      // for instructors
  DISPUTE_FILED
  DISPUTE_RESOLVED
  KYC_APPROVED
  KYC_REJECTED
  PAYOUT_PROCESSED
  PAYOUT_SCHEDULED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CLOSED
}

enum DisputeReferenceType {
  ENROLLMENT
  PAYMENT
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum KycDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  UTILITY_BILL
  BANK_STATEMENT
  OTHER
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PayoutFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

// ============================================================
// MODELS
// ============================================================

model User {
  id             String    @id @default(uuid())
  stellarAddress String    @unique
  email          String?   @unique
  name           String?
  bio            String?
  avatarUrl      String?
  role           UserRole  @default(STUDENT)
  isVerified     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  coursesCreated      Course[]              @relation("InstructorCourses")
  enrollments         Enrollment[]
  assignments         AssignmentSubmission[]
  notifications       Notification[]
  certificates        Certificate[]
  couponsCreated      Coupon[]              @relation("CouponCreator")
  couponRedemptions   CouponRedemption[]    @relation("CouponRedemptions")
  disputesFiled       Dispute[]             @relation("DisputesFiled")
  disputesResolved    Dispute[]             @relation("DisputesResolved")
  kycSubmissions      KycSubmission[]       @relation("KycSubmissions")
  kycReviews          KycSubmission[]       @relation("KycReviews")
  payoutSchedule      PayoutSchedule?       @relation("PayoutSchedule")
  payouts             Payout[]              @relation("Payouts")

  @@map("users")
}

model Course {
  id                  String       @id  // matches on-chain course_id
  instructorAddress   String
  title               String
  description         String?
  category            String       // e.g. "Tailoring", "Makeup", "Baking"
  level               String       @default("Beginner") // Beginner | Intermediate | Advanced
  language            String       @default("English")
  thumbnailUrl        String?
  previewVideoUrl     String?
  price               Decimal      // in USDC (human-readable, e.g. 50.00)
  platformFeePercent  Int          @default(20)
  status              CourseStatus @default(DRAFT)
  totalLessons        Int          @default(0)
  totalDuration       Int          @default(0) // minutes
  totalEnrollments    Int          @default(0)
  totalRevenue        Decimal      @default(0)
  txHash              String?      // on-chain registration tx
  approvedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Relations
  instructor    User          @relation("InstructorCourses", fields: [instructorAddress], references: [stellarAddress])
  modules       CourseModule[]
  enrollments   Enrollment[]
  certificates  Certificate[]
  events        ChainEvent[]
  coupons       Coupon[]

  @@map("courses")
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  position    Int      // ordering within the course
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  course   Course   @relation(fields: [courseId], references: [id])
  lessons  Lesson[]

  @@map("course_modules")
}

model Lesson {
  id           String      @id @default(uuid())
  moduleId     String
  title        String
  description  String?
  type         LessonType  @default(VIDEO)
  videoUrl     String?     // URL to video file (S3 / local)
  videoDuration Int?       // seconds
  content      String?     // for TEXT type lessons
  resourceUrl  String?     // downloadable resource
  position     Int         // ordering within the module
  isFree       Boolean     @default(false) // preview lesson
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  module      CourseModule @relation(fields: [moduleId], references: [id])
  progress    LessonProgress[]
  assignment  Assignment?
  quizQuestions QuizQuestion[]

  @@map("lessons")
}

model QuizQuestion {
  id            String       @id @default(uuid())
  lessonId      String
  question      String
  type          QuestionType @default(SINGLE_CHOICE)
  options       Json?        // Array of options, e.g. ["Option A", "Option B"]
  correctAnswer Json         // Array of correct indices, e.g. [0], or text answer ["True"]
  explanation   String?
  points        Int          @default(1)
  position      Int          // ordering within the lesson
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("quiz_questions")
}

model Assignment {
  id           String   @id @default(uuid())
  lessonId     String   @unique
  title        String
  description  String
  instructions String?
  createdAt    DateTime @default(now())

  // Relations
  lesson      Lesson    @relation(fields: [lessonId], references: [id])
  submissions AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  submissionUrl String?         // uploaded file or link
  notes        String?
  status       AssignmentStatus @default(PENDING)
  feedback     String?          // instructor feedback
  submittedAt  DateTime         @default(now())
  reviewedAt   DateTime?

  // Relations
  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model Enrollment {
  id              String           @id @default(uuid())
  studentId       String
  courseId        String
  amountPaid      Decimal          // USDC paid
  txHash          String?          // on-chain enrollment tx
  status          EnrollmentStatus @default(ACTIVE)
  progressPercent Int              @default(0)  // 0-100
  completedAt     DateTime?
  enrolledAt      DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  student       User            @relation(fields: [studentId], references: [id])
  course        Course          @relation(fields: [courseId], references: [id])
  lessonProgress LessonProgress[]

  @@unique([studentId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  id           String   @id @default(uuid())
  enrollmentId String
  lessonId     String
  completed    Boolean  @default(false)
  watchedSecs  Int      @default(0) // seconds watched
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  lesson     Lesson     @relation(fields: [lessonId], references: [id])

  @@unique([enrollmentId, lessonId])
  @@map("lesson_progress")
}

model Certificate {
  id              String   @id  // matches on-chain certificate_id
  studentId       String
  courseId        String
  courseTitle     String   // stored for quick display
  instructorAddress String
  txHash          String?  // on-chain certificate issuance tx
  isRevoked       Boolean  @default(false)
  issuedAt        DateTime @default(now())

  // Relations
  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@map("certificates")
}

model ChainEvent {
  id         String   @id @default(uuid())
  courseId   String?
  eventName  String
  ledger     Int
  txHash     String
  payload    Json
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Relations
  course Course? @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@index([eventName])
  @@index([processed])
  @@map("chain_events")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  emailSent Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

// ============================================================
// COUPONS
// ============================================================

model Coupon {
  id              String       @id @default(uuid())
  code            String       @unique
  discountType    DiscountType
  discountValue   Decimal      // percentage (0-100) or fixed USDC amount
  maxRedemptions  Int?         // null = unlimited
  redeemedCount   Int          @default(0)
  minOrderAmount  Decimal?     // minimum cart total to apply coupon
  expiresAt       DateTime?    // null = never expires
  isActive        Boolean      @default(true)
  createdById     String       // User (ADMIN or INSTRUCTOR) who created it
  courseId        String?      // null = platform-wide, set = specific course only
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  createdBy   User          @relation("CouponCreator", fields: [createdById], references: [id])
  course      Course?       @relation(fields: [courseId], references: [id])
  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  courseId  String
  discount  Decimal  // actual discount amount applied
  redeemedAt DateTime @default(now())

  // Relations
  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation("CouponRedemptions", fields: [userId], references: [id])

  @@unique([couponId, userId, courseId])
  @@map("coupon_redemptions")
}

// ============================================================
// DISPUTES
// ============================================================

model Dispute {
  id             String               @id @default(uuid())
  filedById      String               // student who filed
  referenceType  DisputeReferenceType
  referenceId    String               // enrollmentId or payment txHash
  subject        String
  description    String
  status         DisputeStatus        @default(OPEN)
  adminNotes     String?
  resolvedById   String?              // admin who resolved
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // Relations
  filedBy    User  @relation("DisputesFiled", fields: [filedById], references: [id])
  resolvedBy User? @relation("DisputesResolved", fields: [resolvedById], references: [id])

  @@index([filedById])
  @@index([status])
  @@map("disputes")
}

// ============================================================
// KYC (Know Your Customer — instructor identity verification)
// ============================================================

model KycSubmission {
  id             String          @id @default(uuid())
  instructorId   String
  documentType   KycDocumentType
  documentUrl    String          // uploaded file path / URL
  additionalUrl  String?         // second document (e.g. selfie)
  status         KycStatus       @default(PENDING)
  adminNotes     String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  instructor  User  @relation("KycSubmissions", fields: [instructorId], references: [id])
  reviewedBy  User? @relation("KycReviews", fields: [reviewedById], references: [id])

  @@index([instructorId])
  @@index([status])
  @@map("kyc_submissions")
}

// ============================================================
// PAYOUTS
// ============================================================

model PayoutSchedule {
  id                String          @id @default(uuid())
  instructorId      String          @unique
  frequency         PayoutFrequency @default(MONTHLY)
  minimumThreshold  Decimal         @default(10) // minimum USDC to trigger payout
  stellarAddress    String          // payout destination address
  isActive          Boolean         @default(true)
  nextPayoutDate    DateTime
  lastPayoutDate    DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  instructor User     @relation("PayoutSchedule", fields: [instructorId], references: [id])
  payouts    Payout[]

  @@map("payout_schedules")
}

model Payout {
  id               String        @id @default(uuid())
  scheduleId       String
  instructorId     String
  amount           Decimal       // USDC amount
  status           PayoutStatus  @default(PENDING)
  txHash           String?       // on-chain payout tx
  periodStart      DateTime
  periodEnd        DateTime
  notes            String?
  processedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  schedule    PayoutSchedule @relation(fields: [scheduleId], references: [id])
  instructor  User           @relation("Payouts", fields: [instructorId], references: [id])

  @@index([instructorId])
  @@index([status])
  @@map("payouts")
}
